{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>konflux-ci/mintmaker//config/renovate/renovate.json"
    ],
    "updateNotScheduled": false,
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "on Tuesday after 3am and before 10am"
        ]
    },
    "packageRules": [
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "ci-dependencies",
            "groupSlug": "ci-dependencies",
            "addLabels": [
                "ok-to-skip-smokes"
            ]
        },
        {
            "matchManagers": [
                "pipenv"
            ],
            "matchUpdateTypes": [
                "lockFileMaintenance"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": false,
            "ignoreTests": false,
            "updateNotScheduled": true,
            "addLabels": [
                "full-run-smoke-tests",
                "dependencies"
            ]
        },
        {
            "matchManagers": [
                "pipenv"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "pin"
            ],
            "enabled": false
        },
        {
            "matchManagers": [
                "dockerfile"
            ],
            "addLabels": [
                "smoke-tests"
            ]
        },
        {
            "matchManagers": [
                "custom.regex"
            ],
            "matchPackageNames": [
                "registry.access.redhat.com/ubi9/nginx-124"
            ],
            "addLabels": [
                "smoke-tests"
            ]
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "deploy/kustomize/patches/nginx.yaml",
                "deploy/clowdapp.yaml"
            ],
            "matchStrings": [
                "name: NGINX_IMAGE_TAG\\s+required: true\\s+value: (?<currentValue>\\S+)"
            ],
            "depNameTemplate": "registry.access.redhat.com/ubi9/nginx-124",
            "datasourceTemplate": "docker",
            "versioningTemplate": "redhat"
        }
    ],
    "schedule": [
        "on Tuesday after 3am and before 10am"
    ],
    "ignorePaths": [
        "dev/containers/**",
        ".pre-commit-config.yaml"
    ]
}
