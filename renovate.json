{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>konflux-ci/mintmaker//config/renovate/renovate.json"
    ],
    "updateNotScheduled": false,
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "on Tuesday after 3am and before 10am"
        ]
    },
    "packageRules": [
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "ci-dependencies",
            "groupSlug": "ci-dependencies",
            "addLabels": [
                "ok-to-skip-smokes"
            ]
        },
        {
            "matchManagers": [
                "pipenv"
            ],
            "matchUpdateTypes": [
                "lockFileMaintenance"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": false,
            "ignoreTests": false,
            "updateNotScheduled": true,
            "addLabels": [
                "full-run-smoke-tests",
                "dependencies"
            ]
        },
        {
            "description": "Group Python package upgrades into one PR",
            "matchCategories": [
                "python"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "pin"
            ],
            "groupName": "Python dependencies",
            "groupSlug": "python-dependencies",
            "separateMajorMinor": false,
            "addLabels": [
                "full-run-smoke-tests",
                "dependencies"
            ]
        },
        {
            "matchManagers": [
                "dockerfile"
            ],
            "addLabels": [
                "smoke-tests"
            ]
        }
    ],
    "schedule": [
        "on Tuesday after 3am and before 10am"
    ],
    "ignorePaths": [
        "dev/containers/**",
        ".pre-commit-config.yaml"
    ]
}
